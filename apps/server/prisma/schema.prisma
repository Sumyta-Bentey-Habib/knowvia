
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  CREATOR
  ADMIN
}

enum CreatorVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ResourceStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ResourceSource {
  ADMIN_CURATED
  CREATOR_SUBMISSION
}

enum ResourceType {
  ARTICLE
  VIDEO
  COURSE
  TUTORIAL
  DOCUMENT
  OTHER
}

enum AccessType {
  FREE
  PAID
  SUBSCRIPTION
  FREEMIUM
  UNKNOWN
}

enum DifficultyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL_LEVELS
  UNKNOWN
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          UserRole @default(USER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  creatorProfile          CreatorProfile?
  reviewedCreatorProfiles CreatorProfile[]    @relation("CreatorProfileReviewer")
  submittedResources      ResourceSubmission[] @relation("SubmissionAuthor")
  reviewedSubmissions     ResourceSubmission[] @relation("SubmissionReviewer")
  createdResources        Resource[]           @relation("ResourceAuthor")
  bookmarks               Bookmark[]
  interests               UserInterest[]
}

model CreatorProfile {
  id                 String                    @id @default(uuid())
  userId             String                    @unique
  displayName        String
  bio                String?                   @db.Text
  websiteUrl         String?
  verificationStatus CreatorVerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  reviewedById       String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("CreatorProfileReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([verificationStatus])
}

model Provider {
  id         String   @id @default(uuid())
  name       String
  slug       String   @unique
  websiteUrl String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  resources    Resource[]
  submissions ResourceSubmission[]
}

model Category {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  parentId    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent             Category?          @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children           Category[]         @relation("CategoryTree")
  resourceCategories ResourceCategory[]
  submissions        ResourceSubmission[]
  userInterests      UserInterest[]

  @@index([parentId])
}

model Resource {
  id                  String           @id @default(uuid())
  title               String
  slug                String           @unique
  summary             String?          @db.Text
  url                 String           @db.Text
  thumbnailUrl        String?          @db.Text
  resourceType        ResourceType
  accessType          AccessType       @default(UNKNOWN)
  difficulty          DifficultyLevel  @default(UNKNOWN)
  language            String?
  durationMinutes     Int?
  status              ResourceStatus   @default(DRAFT)
  source              ResourceSource   @default(ADMIN_CURATED)
  providerId          String
  createdById         String?
  submissionId        String?          @unique
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  provider     Provider           @relation(fields: [providerId], references: [id], onDelete: Restrict)
  createdBy    User?              @relation("ResourceAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  submission   ResourceSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  categories   ResourceCategory[]
  bookmarks    Bookmark[]

  @@index([providerId, status])
  @@index([status, createdAt])
  @@index([resourceType, accessType])
}

model ResourceCategory {
  resourceId String
  categoryId String

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([resourceId, categoryId])
  @@index([categoryId])
}

model ResourceSubmission {
  id               String            @id @default(uuid())
  title            String
  url              String            @db.Text
  summary          String?           @db.Text
  thumbnailUrl     String?           @db.Text
  resourceType     ResourceType
  accessType       AccessType        @default(UNKNOWN)
  difficulty       DifficultyLevel   @default(UNKNOWN)
  language         String?
  durationMinutes  Int?
  status           SubmissionStatus  @default(PENDING)
  submittedById    String
  providerId       String
  categoryId       String?
  reviewedById     String?
  reviewedAt       DateTime?
  rejectionReason  String?           @db.Text
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  submittedBy User      @relation("SubmissionAuthor", fields: [submittedById], references: [id], onDelete: Restrict)
  reviewedBy  User?     @relation("SubmissionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  provider    Provider  @relation(fields: [providerId], references: [id], onDelete: Restrict)
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  publishedResource Resource?

  @@index([status, createdAt])
  @@index([submittedById, status])
  @@index([providerId])
}

model Bookmark {
  userId     String
  resourceId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([userId, resourceId])
  @@index([resourceId])
}

model UserInterest {
  userId     String
  categoryId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([userId, categoryId])
  @@index([categoryId])
}
